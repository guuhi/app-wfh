PORT=3002

DB_HOST=localhost
DB_PORT=5437
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=attendance_db

# Must be identical in auth-service
JWT_SECRET=change-me-to-a-long-random-string

UPLOAD_DIR=./uploads
# "Today" for the one-attendance-per-day rule is calculated in this timezone
APP_TIMEZONE=Asia/Jakarta

CORS_ORIGIN=http://localhost:5173
